  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__01-02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie setzt sich die Annuität zusammen?</p>]]></text>
    </questiontext>
