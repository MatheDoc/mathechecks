      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Aus der Restschuld zu Jahresbeginn: \(Z_k = RK_{k-1} \cdot \frac{p}{100}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Aus der ursprünglichen Darlehenssumme: \(Z_k = K_0 \cdot \frac{p}{100}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das gilt nur im ersten Jahr</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Aus der Annuität: \(Z_k = A \cdot \frac{p}{100}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zinsen beziehen sich auf die Schuld, nicht auf die Zahlung</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Aus der Restschuld zu Jahresende</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Schuld am Jahresanfang wird verzinst</p>]]></text>
      </feedback>
    </answer>
