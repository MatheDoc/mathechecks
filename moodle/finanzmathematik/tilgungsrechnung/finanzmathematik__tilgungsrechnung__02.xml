  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__02-05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Die Laufzeit ist gesucht. Welche Schritte führen zum Ziel?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(T_1\) berechnen, dann \(q^n = \frac{A}{T_1}\) und \(n = \frac{\ln(A/T_1)}{\ln q}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n = \frac{K_0}{A}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ignoriert die Zinsen</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n = \frac{A}{K_0}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ergibt keine sinnvolle Zahl</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Die \(n\)-te Wurzel ziehen</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Wurzel löst nach der Basis auf</p>]]></text>
      </feedback>
    </answer>
