  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__02-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet die Annuitätenformel?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(A = \dfrac{K_0 \cdot q^n \cdot (q-1)}{q^n - 1}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(A = \dfrac{K_0 \cdot (q^n - 1)}{q^n \cdot (q-1)}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist die Barwertformel mit K_0 statt r</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(A = K_0 \cdot q^n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist die Zinseszinsformel</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(A = \dfrac{K_0}{n}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das wäre eine zinslose Ratenzahlung</p>]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__02-02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welcher Zusammenhang besteht zwischen Annuität und erster Tilgung?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(A = T_1 \cdot q^n\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(A = T_1 + q^n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Der Zusammenhang ist multiplikativ</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(A = T_1 \cdot n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Laufzeit steht im Exponenten</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(A = \dfrac{T_1}{q^n}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>T_1 wird aufgezinst, nicht abgezinst</p>]]></text>
      </feedback>
    </answer>
  </question>
