  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__05-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>In einer Zeile des Tilgungsplans sind Restschuld zu Jahresbeginn und Zinsen bekannt. Wie erhält man den Zinssatz?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(p = \dfrac{Z_k}{RK_{k-1}} \cdot 100\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(p = \dfrac{RK_{k-1}}{Z_k} \cdot 100\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zähler und Nenner vertauscht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(p = Z_k - RK_{k-1}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Der Zinssatz ist ein Verhältnis, keine Differenz</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(p = Z_k \cdot RK_{k-1}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Der Zinssatz ist ein Quotient</p>]]></text>
      </feedback>
    </answer>
  </question>
