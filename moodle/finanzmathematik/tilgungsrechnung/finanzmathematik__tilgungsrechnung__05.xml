    <answer fraction="0" format="html">
      <text><![CDATA[<p>Aus der Zinseszinsformel allein</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Annuität muss berücksichtigt werden</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Aus der Rentenendwertformel</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Es geht um eine einzelne Zeile, nicht um eine Rente</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Sie ist falsch</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Sie ergibt sich direkt aus den Zeilenzusammenhängen</p>]]></text>
      </feedback>
    </answer>
