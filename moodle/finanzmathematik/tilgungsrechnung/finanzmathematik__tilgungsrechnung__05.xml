  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__05-05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Bekannt sind Annuität \(A\), Zinssatz und die Restschuld am Jahresende \(RK_k\). Wie erhält man die Restschuld am Jahresanfang \(RK_{k-1}\)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(RK_{k-1} = \dfrac{RK_k + A}{q}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_{k-1} = RK_k + A\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Zinsen des Jahres müssen herausgerechnet werden</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_{k-1} = (RK_k + A) \cdot q\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Es muss durch q geteilt werden, nicht multipliziert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_{k-1} = RK_k - A\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Rückwärts wird addiert, nicht subtrahiert</p>]]></text>
      </feedback>
    </answer>
  </question>
