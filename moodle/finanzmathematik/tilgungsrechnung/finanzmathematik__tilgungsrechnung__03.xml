  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__03-02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet die Restschuldformel mit der ersten Tilgung?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 - \dfrac{T_1 \cdot (q^k - 1)}{q - 1}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 - k \cdot T_1\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Tilgungen wachsen mit q, sind also nicht konstant</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 \cdot q^k - T_1\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Es werden alle bisherigen Tilgungen abgezogen</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 - T_1 \cdot q^k\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Es werden alle Tilgungen summiert, nicht nur die letzte</p>]]></text>
      </feedback>
    </answer>
  </question>
