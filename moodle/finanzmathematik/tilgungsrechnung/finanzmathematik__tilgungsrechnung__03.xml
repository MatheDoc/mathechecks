  <question type="multichoice">
    <name>
      <text>finanzmathematik__tilgungsrechnung__03-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet die Restschuldformel mit der Annuität?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 \cdot q^k - \dfrac{A \cdot (q^k - 1)}{q - 1}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 - k \cdot A\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ignoriert alle Zinsen</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 \cdot q^k - k \cdot A\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Annuitäten müssen aufgezinst werden</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(RK_k = K_0 - \dfrac{A \cdot (q^k - 1)}{q - 1}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das Darlehen muss aufgezinst werden</p>]]></text>
      </feedback>
    </answer>
