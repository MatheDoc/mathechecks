  <question type="multichoice">
    <name>
      <text>finanzmathematik__rentenrechnung__01-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet die Formel für den nachschüssigen Rentenendwert?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(R_n = \dfrac{r \cdot (q^n - 1)}{q - 1}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(R_n = \dfrac{r \cdot q \cdot (q^n - 1)}{q - 1}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist der vorschüssige Rentenendwert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(R_n = \dfrac{r \cdot (q^n - 1)}{q^n \cdot (q - 1)}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist der nachschüssige Rentenbarwert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(R_n = r \cdot q^n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist die Zinseszinsformel für eine Einmalzahlung</p>]]></text>
      </feedback>
    </answer>
  </question>
