  <question type="multichoice">
    <name>
      <text>finanzmathematik__rentenrechnung__02-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet die Formel für den nachschüssigen Rentenbarwert?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(R_0 = \dfrac{r \cdot (q^n - 1)}{q^n \cdot (q - 1)}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(R_0 = \dfrac{r \cdot (q^n - 1)}{q - 1}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist der Rentenendwert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(R_0 = \dfrac{r \cdot q \cdot (q^n - 1)}{q^n \cdot (q - 1)}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist der vorschüssige Rentenbarwert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(R_0 = \dfrac{r}{q^n}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das ist der Barwert einer einzelnen Zahlung</p>]]></text>
      </feedback>
    </answer>
  </question>
