  <question type="multichoice">
    <name>
      <text>finanzmathematik__rentenrechnung__06-02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Ein Angebot lautet: „8 Jahreszahlungen von je 4 500 €, die erste in einem Jahr.“ Wie wird der Barwert berechnet?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Nachschüssiger Rentenbarwert mit \(r = 4\,500\), \(n = 8\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Vorschüssiger Rentenbarwert mit \(r = 4\,500\), \(n = 8\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die erste Zahlung erfolgt am Ende des ersten Jahres, also nachschüssig</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Nachschüssiger Rentenendwert</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Gesucht ist der Barwert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(8 \cdot 4\,500 = 36\,000\) €</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Summe ignoriert die Zinsen</p>]]></text>
