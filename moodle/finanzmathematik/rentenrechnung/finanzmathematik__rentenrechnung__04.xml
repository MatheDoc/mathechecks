  <question type="multichoice">
    <name>
      <text>finanzmathematik__rentenrechnung__04-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet die Formel für das Endkapital beim Kapitalaufbau (nachschüssig)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(E_n = K_0 \cdot q^n + R_n\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(E_n = K_0 \cdot q^n - R_n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Minus gilt beim Kapitalabbau</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(E_n = K_0 + R_n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das Startkapital muss aufgezinst werden</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(E_n = (K_0 + r) \cdot q^n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Raten werden nicht alle n Jahre verzinst</p>]]></text>
      </feedback>
    </answer>
  </question>
