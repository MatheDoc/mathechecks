    <answer fraction="0" format="html">
      <text><![CDATA[<p>Den Logarithmus der Laufzeit bilden</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Der Logarithmus wird gebraucht, wenn eine Laufzeit gesucht ist</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Den Durchschnitt der beiden Laufzeiten bilden</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Laufzeiten sagen nichts über den Zinssatz aus</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_n\) durch \(K_0\) teilen und durch die Gesamtlaufzeit dividieren</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Das wäre lineare Verzinsung</p>]]></text>
