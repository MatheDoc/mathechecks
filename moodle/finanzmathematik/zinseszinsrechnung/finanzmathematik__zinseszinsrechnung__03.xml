    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Zuerst \(K_{n_1}\) vorwärts aus \(K_0\) berechnen, dann in Phase 2 nach \(q_2^{n_2}\) auflösen und die \(n_2\)-te Wurzel ziehen</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
