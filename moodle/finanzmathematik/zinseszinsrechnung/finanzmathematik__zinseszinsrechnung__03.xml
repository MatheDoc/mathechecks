  <question type="multichoice">
    <name>
      <text>finanzmathematik__zinseszinsrechnung__03-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Ein Kapital wird 3 Jahre mit \(q_1\) und danach 4 Jahre mit \(q_2\) verzinst. Wie lautet das Endkapital?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(K_7 = K_0 \cdot q_1^3 \cdot q_2^4\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_7 = K_0 \cdot (q_1 + q_2)^7\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zinsfaktoren werden nicht addiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_7 = K_0 \cdot q_1^3 + K_0 \cdot q_2^4\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Phasen bauen aufeinander auf und werden multipliziert, nicht addiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_7 = K_0 \cdot (q_1 \cdot q_2)^7\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Jeder Faktor gilt nur für seine eigene Phasendauer</p>]]></text>
      </feedback>
    </answer>
  </question>
