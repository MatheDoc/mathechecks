      <text>finanzmathematik__zinseszinsrechnung__03-08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Bei einem Zinssatzwechsel liegt die gesuchte Größe in der ersten Phase (z. B. \(p_1\) oder \(n_1\)). Wie wird der Zwischenwert \(K_{n_1}\) bestimmt?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Rückwärts aus dem Endkapital: \(K_{n_1} = \dfrac{K_n}{q_2^{n_2}}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Vorwärts aus dem Anfangskapital: \(K_{n_1} = K_0 \cdot q_1^{n_1}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Dafür müsste die unbekannte Größe aus Phase 1 schon bekannt sein</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Als Mittelwert von \(K_0\) und \(K_n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zinseszins wächst exponentiell, nicht linear</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Er kann nicht bestimmt werden</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Phase 2 ist vollständig bekannt, also lässt sich rückwärts rechnen</p>]]></text>
      </feedback>
    </answer>
