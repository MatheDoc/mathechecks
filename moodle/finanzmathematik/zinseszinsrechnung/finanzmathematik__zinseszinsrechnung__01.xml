  <question type="multichoice">
    <name>
      <text>finanzmathematik__zinseszinsrechnung__01-04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Gesucht ist \(K_0\) bei bekanntem \(K_n\), \(q\) und \(n\). Welche Umformung ist richtig?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(K_0 = \dfrac{K_n}{q^n}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_0 = K_n \cdot q^n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Aufgezinst statt abgezinst</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_0 = K_n - q^n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zinsfaktor wird dividiert, nicht subtrahiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_0 = \dfrac{q^n}{K_n}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zähler und Nenner vertauscht</p>]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>finanzmathematik__zinseszinsrechnung__01-05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Aus \(K_0 \cdot q^n = K_n\) soll der Zinsfaktor \(q\) bestimmt werden. Welcher Rechenschritt führt zum Ziel?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(q = \sqrt[n]{\dfrac{K_n}{K_0}}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(q = \dfrac{K_n}{K_0 \cdot n}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Division durch n löst keine Potenz auf</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(q = \dfrac{\ln(K_n / K_0)}{\ln n}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Der Logarithmus wird gebraucht, wenn n gesucht ist</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(q = \left(\dfrac{K_n}{K_0}\right)^n\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Potenzieren statt Wurzelziehen</p>]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>finanzmathematik__zinseszinsrechnung__01-06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Aus \(q^n = 2\) soll \(n\) bestimmt werden. Welcher Ausdruck ist richtig?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(n = \dfrac{\ln 2}{\ln q}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n = \dfrac{\ln q}{\ln 2}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zähler und Nenner vertauscht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n = \ln 2 - \ln q\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Logarithmen werden dividiert, nicht subtrahiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n = \sqrt[q]{2}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Wurzelziehen löst nach der Basis auf, nicht nach dem Exponenten</p>]]></text>
      </feedback>
    </answer>
  </question>
