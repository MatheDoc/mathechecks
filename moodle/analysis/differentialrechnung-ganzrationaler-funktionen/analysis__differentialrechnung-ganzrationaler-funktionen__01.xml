  <question type="multichoice">
    <name>
      <text>analysis__differentialrechnung-ganzrationaler-funktionen__01-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel berechnet die mittlere Änderungsrate von \(f\) im Intervall \([a;b]\)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(\frac{f(b)-f(a)}{b-a}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\frac{b-a}{f(b)-f(a)}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Änderung der Stelle und Änderung des Funktionswerts vertauscht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\frac{f(b)-f(a)}{b+a}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Intervalllänge als Summe statt als Differenz gebildet</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\frac{f(b)+f(a)}{b-a}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Funktionswerte addiert statt ihre Änderung zu bilden</p>]]></text>
      </feedback>
    </answer>
  </question>
