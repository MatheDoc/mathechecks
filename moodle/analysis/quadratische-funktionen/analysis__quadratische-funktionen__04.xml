  <question type="multichoice">
    <name>
      <text>analysis__quadratische-funktionen__04-04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche \(p\)-\(q\)-Formel ist richtig?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(x_{1{,}2}=-\frac{p}{2}\pm\sqrt{\left(\frac{p}{2}\right)^2-q}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(x_{1{,}2}=\frac{p}{2}\pm\sqrt{\left(\frac{p}{2}\right)^2-q}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Minuszeichen vor \(\frac{p}{2}\) vergessen</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(x_{1{,}2}=-\frac{p}{2}\pm\sqrt{\left(\frac{p}{2}\right)^2+q}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Vorzeichen vor \(q\) unter der Wurzel verwechselt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(x_{1{,}2}=-p\pm\sqrt{p^2-q}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die Halbierung von \(p\) wurde an beiden Stellen vergessen</p>]]></text>
      </feedback>
    </answer>
  </question>
