    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Damit sich positive und negative Abweichungen nicht aufheben.</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Damit jede Abweichung negativ wird.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Quadrate fälschlich als negative Werte gedeutet</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Damit alle Datenpunkte exakt auf dem Graphen liegen.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Quadrieren mit einer exakten Interpolation verwechselt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Damit keine Koeffizienten mehr bestimmt werden müssen.</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Die notwendige Parameterbestimmung fälschlich für überflüssig gehalten</p>]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>analysis__regression__02-05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Summe wird bei der Regression minimiert?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(S=\sum (y_i-f(x_i))^2\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(S=\sum (y_i+f(x_i))\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Messwert und Modellwert addiert und nicht quadriert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(S=\sum (x_i-y_i)^2\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>x- und y-Daten direkt verglichen statt Messwert und Modellwert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(S=\sum f(x_i)^2\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Nur Modellwerte betrachtet und Messwerte weggelassen</p>]]></text>
      </feedback>
    </answer>
  </question>
