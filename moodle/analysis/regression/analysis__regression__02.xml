  <question type="multichoice">
    <name>
      <text>analysis__regression__02-03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet die Abweichung eines Messpunkts \((x_i\mid y_i)\) vom Modellwert?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(y_i-f(x_i)\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(x_i-f(y_i)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>x- und y-Rolle vertauscht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(y_i+f(x_i)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Messwert und Modellwert addiert statt subtrahiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(f(x_i)\cdot y_i\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Messwert und Modellwert multipliziert statt subtrahiert</p>]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
