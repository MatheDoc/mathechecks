  <question type="multichoice">
    <name>
      <text>analysis__regression__02-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welcher Ansatz gehört zu einer quadratischen Regressionsfunktion?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(f(x)=ax^2+bx+c\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(f(x)=mx+b\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Linearen statt quadratischen Ansatz gewählt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(f(x)=ax^3+bx^2+cx+d\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Kubischen statt quadratischen Ansatz gewählt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(f(x)=a\cdot e^{bx}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Exponentiellen statt quadratischen Ansatz gewählt</p>]]></text>
      </feedback>
    </answer>
  </question>
