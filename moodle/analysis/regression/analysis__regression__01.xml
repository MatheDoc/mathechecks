  <question type="multichoice">
    <name>
      <text>analysis__regression__01-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel liefert die Steigung \(m\) einer linearen Regressionsgeraden?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(m=\frac{\sum (x_i-\bar{x})(y_i-\bar{y})}{\sum (x_i-\bar{x})^2}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(m=\frac{\sum (x_i-\bar{x})^2}{\sum (x_i-\bar{x})(y_i-\bar{y})}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zähler und Nenner der Regressionsformel vertauscht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(m=\bar{y}-\bar{x}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Nur die Differenz der Mittelwerte verwendet</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(m=\frac{\bar{x}}{\bar{y}}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Quotient der Mittelwerte statt der Regressionsformel verwendet</p>]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>analysis__regression__01-02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel liefert den y-Achsenabschnitt \(b\), wenn \(m\), \(\bar{x}\) und \(\bar{y}\) bekannt sind?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(b=\bar{y}-m\cdot\bar{x}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(b=\bar{x}-m\cdot\bar{y}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>x- und y-Mittelwert vertauscht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(b=\bar{y}+m\cdot\bar{x}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Vorzeichen vor \(m\cdot\bar{x}\) vertauscht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(b=m-\bar{x}-\bar{y}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Größen ohne Bezug zur Schwerpunktgleichung subtrahiert</p>]]></text>
      </feedback>
    </answer>
  </question>
