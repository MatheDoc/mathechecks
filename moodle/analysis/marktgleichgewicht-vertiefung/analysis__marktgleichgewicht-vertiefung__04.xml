  <question type="multichoice">
    <name>
      <text>analysis__marktgleichgewicht-vertiefung__04-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel beschreibt die Konsumentenrente im Marktgleichgewicht?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(KR=\int_0^{x_G}p_N(x)\,dx-x_G\cdot p_G\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(KR=x_G\cdot p_G-\int_0^{x_G}p_N(x)\,dx\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zahlungsbereitschaft und Umsatz in falscher Reihenfolge subtrahiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(KR=\int_0^{x_G}p_A(x)\,dx-x_G\cdot p_G\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Angebotsfunktion statt Nachfragefunktion verwendet</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(KR=x_G\cdot p_G+\int_0^{x_G}p_N(x)\,dx\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Zahlungsbereitschaft und Umsatz addiert statt subtrahiert</p>]]></text>
      </feedback>
    </answer>
  </question>
