  <question type="multichoice">
    <name>
      <text>stochastik__binomialverteilung__07-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel berechnet den Erwartungswert einer Binomialverteilung?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(\mu=np\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\mu=n(1-p)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Erwartete Nieten statt Treffer berechnet</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\mu=\sqrt{np(1-p)}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Standardabweichungsformel gewählt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\mu=n/p\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Multiplikation durch Division ersetzt</p>]]></text>
      </feedback>
    </answer>
