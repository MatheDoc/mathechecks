  <question type="multichoice">
    <name>
      <text>stochastik__binomialverteilung__15-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Wie wird \(\sigma^2=np(1-p)\) nach \(n\) umgestellt?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(n=\frac{\sigma^2}{p(1-p)}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n=\frac{\sigma}{p(1-p)}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Standardabweichung nicht quadriert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n=\sigma^2p(1-p)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Multipliziert statt dividiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(n=\frac{p(1-p)}{\sigma^2}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Quotient umgekehrt</p>]]></text>
      </feedback>
    </answer>
  </question>
