    <questiontext format="html">
      <text><![CDATA[<p>Wie lautet der Satz von Sylvester?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(P(A\cup B)=P(A)+P(B)-P(A\cap B)\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cup B)=P(A)+P(B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Doppelt gezählte Schnittmenge nicht abgezogen</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cup B)=P(A)\cdot P(B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Vereinigung durch ein Produkt berechnet</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cup B)=P(A\cap B)-P(A)-P(B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Vorzeichen und Reihenfolge vollständig vertauscht</p>]]></text>
      </feedback>
    </answer>
  </question>
