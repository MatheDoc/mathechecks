  <question type="multichoice">
    <name>
      <text>stochastik__mehrstufige-zufallsexperimente__02-02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel liefert eine unbekannte zweite Astwahrscheinlichkeit \(q\) aus \(P(A)\) und \(P(A\cap B)\)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(q=\frac{P(A\cap B)}{P(A)}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(q=P(A\cap B)\cdot P(A)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Pfadmultiplikation erneut angewendet statt umgeformt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(q=P(A\cap B)+P(A)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Wahrscheinlichkeiten addiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(q=P(A)-P(A\cap B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Differenz statt Quotient gebildet</p>]]></text>
      </feedback>
    </answer>
  </question>
