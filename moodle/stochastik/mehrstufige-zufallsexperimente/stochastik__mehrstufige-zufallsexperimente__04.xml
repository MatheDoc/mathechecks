    <name>
      <text>stochastik__mehrstufige-zufallsexperimente__04-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Ergebnismenge gehört zu einem zweistufigen Baum mit \(A,\overline{A}\) und danach \(B,\overline{B}\)?</p>]]></text>
