  <question type="multichoice">
    <name>
      <text>stochastik__zufallsgroessen__01-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel berechnet den Erwartungswert einer diskreten Zufallsgröße?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(E(X)=\sum x_i\cdot P(X=x_i)\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(E(X)=\sum x_i+P(X=x_i)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Werte und Wahrscheinlichkeiten addiert statt multipliziert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(E(X)=\sum P(X=x_i)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Nur die stets 1 ergebende Wahrscheinlichkeitssumme gebildet</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(E(X)=\sqrt{\sum x_i^2}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Ungewichtete Quadratsumme verwendet</p>]]></text>
      </feedback>
    </answer>
  </question>
