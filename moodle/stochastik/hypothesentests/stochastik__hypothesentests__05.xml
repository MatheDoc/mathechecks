    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\overline{A}=\{0,\ldots,k-1\}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Grenzwert \(k\) fälschlich ausgeschlossen</p>]]></text>
      </feedback>
    </answer>
