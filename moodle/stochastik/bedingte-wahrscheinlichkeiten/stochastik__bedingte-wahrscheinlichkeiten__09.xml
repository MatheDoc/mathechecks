    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=P(A)\cdot P(B)\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=P(A)+P(B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Produktregel durch Addition ersetzt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=P(A)-P(B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Produktregel durch Subtraktion ersetzt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=1-P(A)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Schnittwahrscheinlichkeit mit Gegenwahrscheinlichkeit verwechselt</p>]]></text>
