    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Gleichung darf wegen der gegebenen Unabhängigkeit von \(A\) und \(B\) verwendet werden?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
