  <question type="multichoice">
    <name>
      <text>stochastik__bedingte-wahrscheinlichkeiten__06-10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Gleichung liefert bei unabhängigen Ereignissen direkt das erste innere Feld einer Vier-Felder-Tafel?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=P(A)\cdot P(B)\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=P(A)+P(B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Produktregel durch Addition ersetzt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=P(A)-P(B)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Produktregel durch Subtraktion ersetzt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(P(A\cap B)=1-P(A)\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Schnittwahrscheinlichkeit mit Gegenwahrscheinlichkeit verwechselt</p>]]></text>
      </feedback>
    </answer>
