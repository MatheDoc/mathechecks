  <question type="multichoice">
    <name>
      <text>lineare-algebra__mehrstufige-produktionsprozesse__06-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welche Formel beschreibt den Vektor der variablen Stückkosten?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(\vec{k}_v=\vec{k}_R\cdot RE+\vec{k}_Z\cdot ZE+\vec{k}_E\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(K_v=\vec{k}_R\cdot RE+\vec{k}_Z\cdot ZE+\vec{k}_E\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Vektor der Stückkosten mit gesamten variablen Kosten verwechselt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\vec{k}_v=\vec{k}_R+\vec{k}_Z+\vec{k}_E\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Produktionsbedarf der Kostenanteile ignoriert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\vec{k}_v=\vec{k}_R\cdot RZ+\vec{k}_Z\cdot RE+\vec{k}_E\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>RE und ZE den falschen Kostenstufen zugeordnet</p>]]></text>
      </feedback>
    </answer>
  </question>
