  <question type="multichoice">
    <name>
      <text>lineare-algebra__mehrstufige-produktionsprozesse__05-01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>\(RE\) ist quadratisch und invertierbar. Welche Formel liefert bei vollständiger Lagerräumung \(\vec{m}\) aus \(\vec{r}\)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(\vec{m}=RE^{-1}\cdot\vec{r}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\vec{m}=RE\cdot\vec{r}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Ohne Inverse multipliziert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\vec{m}=\vec{r}\cdot RE^{-1}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Matrix und Vektor in falscher Reihenfolge multipliziert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\vec{r}=RE^{-1}\cdot\vec{m}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Input und Output vertauscht</p>]]></text>
      </feedback>
    </answer>
  </question>
