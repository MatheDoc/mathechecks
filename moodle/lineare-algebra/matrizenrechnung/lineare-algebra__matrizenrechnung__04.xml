  <question type="multichoice">
    <name>
      <text>lineare-algebra__matrizenrechnung__04-05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Nach zwei Pivotstufen: Welche Form soll die linke untere Ecke besitzen?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist richtig.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist teilweise richtig.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Die Antwort ist falsch.</p>]]></text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>\(\begin{pmatrix}*&*&*\\0&*&*\\0&0&*\end{pmatrix}\)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\begin{pmatrix}*&0&0\\*&*&0\\*&*&*\end{pmatrix}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Obere statt untere Einträge eliminiert</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\begin{pmatrix}0&*&*\\0&*&*\\0&0&*\end{pmatrix}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Ersten Pivot fälschlich zu null gemacht</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\(\begin{pmatrix}*&*&0\\0&*&0\\0&0&0\end{pmatrix}\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Dritten Pivot fälschlich als null vorausgesetzt</p>]]></text>
      </feedback>
    </answer>
  </question>
