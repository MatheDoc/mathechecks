      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>\((A+B)^T=B^TA^T\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Summenregel mit Produktregel verwechselt</p>]]></text>
