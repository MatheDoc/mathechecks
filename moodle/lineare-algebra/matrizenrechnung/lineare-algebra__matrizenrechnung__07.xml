    <answer fraction="0" format="html">
      <text><![CDATA[<p>\((AB)^T=A^TB^T\)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Reihenfolge beim Transponieren des Produkts nicht umgekehrt</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
